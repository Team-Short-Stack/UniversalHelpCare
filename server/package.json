{
  "name": "@universal-help-care/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "VCS_REF_HEAD_REVISION=$(git rev-parse HEAD 2>/dev/null) tsx watch --env-file-if-exists=../.env --import ./src/instrumentation.ts src/index.ts",
    "start": "VCS_REF_HEAD_REVISION=$(git rev-parse HEAD 2>/dev/null) tsx --env-file-if-exists=../.env --import ./src/instrumentation.ts src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:call-flow": "tsx --test src/call-flow.test.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.0",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.3",
    "@openai/agents": "0.19.0",
    "@openai/agents-extensions": "0.19.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "fastify": "^5.12.5",
    "tsx": "^4.23.15",
    "twilio": "^6.1.2",
    "twilio-agent-connect": "^2.4.0",
    "xstate": "^5.33.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
